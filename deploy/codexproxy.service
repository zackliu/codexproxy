[Unit]
Description=Codex WSL Proxy for Azure OpenAI (Entra ID)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/codexproxy

# Safe defaults. Override in /etc/default/codexproxy.
Environment=HOME=/root
Environment=NODE_BIN=/root/.nvm/versions/node/v22.22.0/bin/node
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=17777
Environment=UPSTREAM_AOAI_BASE_URL=https://pmagent2.openai.azure.com/openai/v1
Environment=AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
Environment=TOKEN_REFRESH_BUFFER_MS=300000
Environment=UPSTREAM_HEADERS_TIMEOUT_MS=30000
Environment=UPSTREAM_BODY_TIMEOUT_MS=600000
EnvironmentFile=-/etc/default/codexproxy

ExecStartPre=/bin/bash -lc 'test -x "${NODE_BIN}"'
ExecStart=/bin/bash -lc 'exec "${NODE_BIN}" /root/codexproxy/src/index.js'

Restart=always
RestartSec=3
SyslogIdentifier=codexproxy
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
